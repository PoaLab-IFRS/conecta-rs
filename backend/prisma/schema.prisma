generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id_user     Int @id @default(autoincrement())
  name        String 
  email       String  @unique
  password    String
}

model Capital {
  id_capital  Int @id @default(autoincrement())
  name        String
  asset_num   String
  description String?
}
