{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "yarn --cwd .. lint:backend",
    "lint:fix": "yarn --cwd .. lint:backend:fix",
    "format": "yarn --cwd .. format:backend",
    "format:check": "yarn --cwd .. format:backend:check",
    "validate": "yarn --cwd .. lint:backend && yarn --cwd .. format:backend:check",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "6",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
